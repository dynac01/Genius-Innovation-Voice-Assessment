{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Voice Conversation",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Declared, not required. Codespaces prompts for anything listed here that the
  // person has not already set, which turns "why are the real options greyed out?"
  // into a question answered before the Codespace exists.
  //
  // Nothing breaks without them: the demo runs end to end on fakes, which is the
  // whole point of building the fakes first. These only decide what the UI is
  // *allowed* to offer.
  "secrets": {
    "DEEPGRAM_API_KEY": {
      "description": "Optional. Enables real speech-to-text (Nova-3) and text-to-speech (Aura-2). One key covers both. Without it those dropdowns stay on their fakes.",
      "documentationUrl": "https://console.deepgram.com"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Enables the real model. Without it the Model dropdown stays on the canned reply.",
      "documentationUrl": "https://console.anthropic.com"
    }
  },

  // Split across three lifecycle hooks so a prebuild can actually bake the slow part.
  //
  // Prebuilds run `onCreateCommand` and `updateContentCommand` on push and store the
  // result in the image; `postCreateCommand` runs afterwards on every Codespace and
  // is never baked. Putting `pnpm install` there — which is where it was — means a
  // prebuild saves almost nothing, because the expensive step still runs on open.
  //
  // corepack reads the pnpm version from the `packageManager` field in package.json,
  // so it is not repeated here. One source of truth, shared with CI.
  "onCreateCommand": "corepack enable",

  // Baked by the prebuild, and re-run when a prebuild is refreshed against newer
  // source — which is exactly the property `pnpm install` wants. Frozen, so a
  // Codespace can never resolve versions CI did not test.
  "updateContentCommand": "pnpm install --frozen-lockfile",

  // Start both halves on attach, so a Codespace opens on a running demo rather than
  // on a terminal and a README. `pnpm dev` runs the Nest server and Vite together.
  "postAttachCommand": "pnpm dev",

  // Codespaces serves forwarded ports over HTTPS, which makes the page a secure
  // context — the precondition for getUserMedia. This is what lets the microphone
  // work in a Codespace, and why the demo is genuinely developable there.
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": {
      "label": "web (Vite)",
      // openBrowser, not openPreview. VS Code's embedded preview is a webview, and
      // getUserMedia in it is unreliable at best — for a voice demo that means the
      // microphone never opens and the cause is invisible. A real browser tab is
      // also where the HTTPS forwarding becomes a secure context, which is the
      // precondition for the microphone at all.
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "server (HTTP + WebSocket)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "vitest.explorer"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
