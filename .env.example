# ---------------------------------------------------------------------------
# Voice Conversation — configuration
#
# Every value here is OPTIONAL. With no .env at all, the app runs end to end on
# the fakes: a scripted STT, a canned LLM, and a silent TTS. That is the default
# on purpose — clone the repo, `pnpm install && pnpm dev`, and the whole loop
# works with no accounts, no keys, and no spend. The test suite and CI never read
# these values.
#
# Set the keys below only when you want to hear real audio.
# ---------------------------------------------------------------------------

# --- Pipeline selection ----------------------------------------------------
# Which implementation to use for each stage of the pipeline.
#   STT_PROVIDER:  fake | deepgram
#   LLM_PROVIDER:  fake | anthropic
#   TTS_PROVIDER:  fake | deepgram | elevenlabs
#
# These are the criterion-7 swap: changing a value here must require no change
# to @voice/core.
STT_PROVIDER=fake
LLM_PROVIDER=fake
TTS_PROVIDER=fake

# --- Deepgram (STT: Nova-3, TTS: Aura-2) -----------------------------------
# One key covers both. https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Anthropic (LLM: Claude Haiku 4.5) -------------------------------------
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- ElevenLabs (alternate TTS: Flash v2.5) --------------------------------
# Only needed to demonstrate swapping one pipeline component for another.
ELEVENLABS_API_KEY=

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
